; EzyMap Scalp Mastery V3.190 - EzyMap_V3_190_STAGE5.set
; STAGE 5 - adds scale-into-strength layering (1 initial layer, add up to 2
; more only when green by 0.5 x ATR). Cumulative: S1..S5.
;
; Only the V3.190 S01-S05 inputs are listed. Every other input keeps the
; value already in your terminal, so load this ON TOP of your working set.
; InpATRTimeframe=5 is PERIOD_M5.
;
InpTrailArmPips=4.0
InpTrailInitialDistancePips=12.0
InpTrailTightenAtPips=16.0
InpTrailTightDistancePips=7.0
InpUseBreakevenLock=true
InpBreakevenLockAtPips=9.0
InpBreakevenLockOffsetPips=1.0
InpUsePartialTakeProfit=true
InpPartialTPPips=11.0
InpPartialTPPercent=55.0
InpBreakevenAfterPartial=true
InpUseATRGeometry=true
InpATRPeriod=14
InpATRTimeframe=5
InpATRStopMultiplier=1.6
InpATRTrailMultiplier=0.55
InpATRArmMultiplier=0.35
InpATRStopFloorPips=12.0
InpATRStopCeilingPips=35.0
InpATRTrailFloorPips=5.0
InpRequireTouchConfirmation=true
InpTouchConfirmMode=0
InpTouchStallSeconds=3
InpTouchStallMaxExtendPips=2.0
InpTouchConfirmTimeoutSec=45
InpScaleInOnConfirmation=true
InpInitialLayerCount=1
InpScaleInTriggerATRMult=0.5
InpMaxScaleInLayers=2
